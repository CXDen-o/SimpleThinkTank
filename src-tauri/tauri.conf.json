{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleThinkTank",
  "version": "0.2.0",
  "identifier": "com.simplethinktank.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智识库",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CXDen-o",
    "copyright": "Copyright © 2026 CXDen-o",
    "shortDescription": "本地私有化 RAG 知识库",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
